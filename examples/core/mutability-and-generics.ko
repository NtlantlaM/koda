// Generic function spelling is accepted; inference remains unspecified and outside Slice 2A.
import { print } from "koda:io"

fn identity<T>(value: T) -> T {
    value
}

export fn main() -> Unit {
    label = identity("ready")
    mut count = 0
    count = count + 1
    print(label)
    if count == 1 {
        print("count updated")
    } else {
        print("unexpected count")
    }
}
