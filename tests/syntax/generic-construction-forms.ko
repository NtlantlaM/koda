// Slice 3A: `Name<Args>` is an application only before `{`, `.` or `(`.
// Everything here is accepted; the point is that `<` still reads as comparison
// and that a control head still restricts a record literal.
type Box<T> { value: T }
enum Wrap<T> { Has(value: T) }

fn truth(box: Box<Int>) -> Bool { box.value > 0 }

fn comparisons(a: Int, b: Int, c: Int) -> Bool {
    less = a < b
    greater = b > c
    chainLike = a < b
    following = b > c
    less && greater && chainLike && following
}

fn comparisonInControlHead(a: Int, b: Int) -> Int {
    if a < b { 1 } else { 2 }
}

fn constructionInsideAControlHead() -> Int {
    // A record literal is suppressed in a head, so this needs the call's
    // argument list or parentheses to restore it.
    if truth(Box<Int> { value: 1 }) { 1 } else { 2 }
}

fn parenthesisedInControlHead() -> Int {
    if (Box<Int> { value: 1 }).value > 0 { 1 } else { 2 }
}

fn multilineTypeArguments() -> Box<Box<Int>> {
    Box<
        Box<Int>
    > {
        value: Box<Int> { value: 1 }
    }
}

fn nullableArgument() -> Box<Int?> {
    Box<Int?> { value: null }
}

fn qualifiedVariantStillWorks() -> Wrap<Int> {
    Wrap<Int>.Has(1)
}
