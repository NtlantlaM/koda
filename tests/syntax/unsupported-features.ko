// Accepted v0.1 features this compiler slice does not implement yet. Each one
// must say so explicitly rather than be parsed approximately.
//
// `type` and `enum` left this list in slice 1A, `match` in slice 1B, and `T?`
// with `null` in slice 1C; their fixtures live in tests/types/.
import { print } from "koda:io"

type Person {
    name: String
    nickname: String?
}

entity Account {
    id: Int
}

fn constrained<T: Int>(value: T) -> T {
    value
}

fn nullableUnit(value: Unit?) -> Unit {
    value
}

export fn main() -> Unit {
    person = Person { name: "a", nickname: null }

    // Matching is implemented for enums and nullable values; a record
    // scrutinee is not.
    label = match person {
        _ => "any"
    }

    // Bool matching is not implemented.
    flag = match true {
        _ => "any"
    }

    print(label + flag)
}
